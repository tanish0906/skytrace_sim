<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Military_Jet_Aircraft_macro">

  <xacro:macro name="Military_Jet_Aircraft" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.158822 -0.003225 -0.387857" rpy="0 0 0"/>
        <mass value="0.013009"/>
        <inertia ixx="1.388029e-06" ixy="-1.157540e-11" ixz="6.453440e-11"
                 iyy="1.695719e-06" iyz="-1.344076e-08" izz="1.000000e-06"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Military_Jet_Aircraft_description/meshes/Military_Jet_Aircraft/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Military_Jet_Aircraft_description/meshes/Military_Jet_Aircraft/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>

</robot>