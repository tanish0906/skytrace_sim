<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Military_Jet_Aircraft">

  <!-- Materials (shared across all assemblies) -->
  <material name="Steel">
    <color rgba="0.729 0.600 0.518 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find Military_Jet_Aircraft_description)/urdf/assemblies/Military_Jet_Aircraft.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:Military_Jet_Aircraft prefix=""/>

</robot>